---
// flip .dark on <html>; key read by the inline script in Base.astro
---

<button
  id="theme-toggle"
  aria-label="Toggle dark mode"
  style="background:none;border:none;cursor:pointer;padding:0.4rem;color:var(--color-text-muted);font-size:1.05rem;line-height:1;"
>
  ◐
</button>

<script is:inline>
  (function () {
    var b = document.getElementById('theme-toggle');
    if (b) b.addEventListener('click', function () {
      var dark = document.documentElement.classList.toggle('dark');
      try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch (e) {}
    });
  })();
</script>
