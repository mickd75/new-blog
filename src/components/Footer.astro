---
import { getEntry } from 'astro:content';

const siteContent = (await getEntry('site', 'site'))?.data || {
  copyrightText: '© {year} New Blog. Built with Astro and Cloudflare Pages.',
  footerLinks: '',
};

const currentYear = new Date().getFullYear();
const copyrightHtml = siteContent.copyrightText.replace('{year}', currentYear);
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-top" style="grid-template-columns: 2fr 1fr;">
      <div class="footer-brand">
        <a href="/" class="footer-logo">New<span class="accent">Blog</span></a>
        <p class="footer-about" set:html={siteContent.footerLinks} />
      </div>
      <div class="footer-col">
        <h4>Explore</h4>
        <ul>
          <li><a href="/blog">All Articles</a></li>
          <li><a href="/about">About</a></li>
          <li><a href="/privacy">Privacy Policy</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <p set:html={copyrightHtml} />
      <p class="footer-tagline">Your tagline here</p>
    </div>
  </div>
</footer>
