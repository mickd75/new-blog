---
import PageLayout from '../layouts/Page.astro';
---

<PageLayout title="Page Not Found | Crazzy Monday">
  <main id="main" class="section">
    <div class="container-narrow" style="text-align: center; padding-top: var(--space-3xl);">
      <h1 class="section-title" style="font-size: clamp(3rem, 6vw, 5rem);">404</h1>
      <p style="color: var(--color-text-muted); margin-bottom: var(--space-xl);">That page doesn't exist (or moved during the migration).</p>
      <a href="/" class="btn btn-primary">Back to Home</a>
    </div>
  </main>
</PageLayout>
