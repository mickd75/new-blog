---
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Crazzy Monday', description = 'Practical articles on fitness, personal finance, and self-improvement.' } = Astro.props;
---

<Base title={title} description={description}>
  <Nav />
  <main id="main">
    <slot />
  </main>
  <Footer />
</Base>
