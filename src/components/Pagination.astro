---
interface Props {
  page: number;
  totalPages: number;
  basePath?: string;
}

const { page, totalPages, basePath = '' } = Astro.props;
const url = (p: number) => (p === 1 ? (basePath || '/') : `${basePath}/page/${p}`);

const pages: (number | '…')[] = [];
for (let i = 1; i <= totalPages; i++) {
  if (i === 1 || i === totalPages || Math.abs(i - page) <= 1) pages.push(i);
  else if (pages[pages.length - 1] !== '…') pages.push('…');
}
---

{totalPages > 1 && (
  <nav class="pagination" aria-label="Pagination">
    {page > 1 ? (
      <a href={url(page - 1)} class="page-btn">← Prev</a>
    ) : (
      <span class="page-btn disabled">← Prev</span>
    )}

    {pages.map((p) => p === '…' ? (
      <span class="page-dots">…</span>
    ) : p === page ? (
      <span aria-current="page" class="page-btn current">{p}</span>
    ) : (
      <a href={url(p)} class="page-btn">{p}</a>
    ))}

    {page < totalPages ? (
      <a href={url(page + 1)} class="page-btn">Next →</a>
    ) : (
      <span class="page-btn disabled">Next →</span>
    )}
  </nav>
)}

<style>
  .pagination { display: flex; align-items: center; justify-content: center; gap: var(--space-sm); margin-top: var(--space-3xl); flex-wrap: wrap; }
  .page-btn {
    padding: 0.45rem 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-muted);
    transition: all var(--transition);
  }
  a.page-btn:hover { border-color: var(--color-accent); color: var(--color-accent); }
  .page-btn.current { background: var(--color-accent); border-color: var(--color-accent); color: #fff; }
  .page-btn.disabled { opacity: 0.4; }
  .page-dots { color: var(--color-text-light); padding: 0 0.2rem; }
</style>
